# Modèle du fichier .env lu par docker-compose.yml. Copiez-le en .env (ignoré par Git) et
# remplacez la valeur par une valeur générée sur votre poste :
#   echo "CATALOG_DB_PASSWORD=$(openssl rand -hex 24)" > .env
# Hexadécimal : aucun caractère qui casserait la chaîne de connexion (; = ').
CATALOG_DB_PASSWORD=<a-generer-localement>
